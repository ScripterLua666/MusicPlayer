-- ============ UNIVERSAL LOADER ============
local function attachLoader(cardHandle, statusHandle, url)
    local loading = false

    cardHandle.LoadBtn.MouseButton1Click:Connect(function()
        if loading then return end
        loading = true

        statusHandle.Text.Text = "Loading..."
        TweenService:Create(statusHandle.Text, TweenInfo.new(0.2), {TextColor3 = C.Warn}):Play()
        TweenService:Create(statusHandle.Dot, TweenInfo.new(0.2), {BackgroundColor3 = C.Warn}):Play()
        cardHandle.LoadBtn.Text = "..."
        TweenService:Create(cardHandle.LoadBtn, TweenInfo.new(0.2), {BackgroundColor3 = C.Warn}):Play()

        task.spawn(function()
            local function fail(msg)
                statusHandle.Text.Text = msg
                TweenService:Create(statusHandle.Text, TweenInfo.new(0.2), {TextColor3 = C.Error}):Play()
                TweenService:Create(statusHandle.Dot, TweenInfo.new(0.2), {BackgroundColor3 = C.Error}):Play()
                warn("[Bacon Hub] " .. msg)
                task.wait(2)
                cardHandle.LoadBtn.Text = "LOAD"
                TweenService:Create(cardHandle.LoadBtn, TweenInfo.new(0.2), {BackgroundColor3 = C.Accent}):Play()
                loading = false
            end

            local function succeed(warningMode)
                if warningMode then
                    statusHandle.Text.Text = "Loaded with warnings"
                    TweenService:Create(statusHandle.Text, TweenInfo.new(0.2), {TextColor3 = C.Warn}):Play()
                    TweenService:Create(statusHandle.Dot, TweenInfo.new(0.2), {BackgroundColor3 = C.Warn}):Play()
                else
                    statusHandle.Text.Text = "Script loaded successfully ✓"
                    TweenService:Create(statusHandle.Text, TweenInfo.new(0.2), {TextColor3 = C.Success}):Play()
                    TweenService:Create(statusHandle.Dot, TweenInfo.new(0.2), {BackgroundColor3 = C.Success}):Play()
                end
                cardHandle.LoadBtn.Text = "LOADED"
                TweenService:Create(cardHandle.LoadBtn, TweenInfo.new(0.2), {BackgroundColor3 = C.Success}):Play()
                task.wait(1.5)
                cardHandle.LoadBtn.Text = "LOAD"
                TweenService:Create(cardHandle.LoadBtn, TweenInfo.new(0.2), {BackgroundColor3 = C.Accent}):Play()
                loading = false
            end

            local source
            local ok1 = pcall(function() source = game:HttpGet(url) end)
            if not ok1 or not source or source == "" then
                local ok2, res = pcall(function() return game:HttpGetAsync(url) end)
                if ok2 then source = res end
            end

            if not source or source == "" then
                fail("Failed to download"); return
            end
            if type(source) ~= "string" then
                fail("Invalid data"); return
            end
            if #source < 20 then
                fail("Empty script"); return
            end

            local fn, compileErr = loadstring(source)
            if not fn then
                fail("Compile failed")
                warn("[Bacon Hub] compile error:", compileErr)
                return
            end

            local ok3, runErr = pcall(fn)
            if not ok3 then
                warn("[Bacon Hub] runtime warning:", runErr)
                succeed(true)
            else
                succeed(false)
            end
        end)
    end)
end

