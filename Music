-- // ============ ANIMATION ============
local startTime = tick()
local finished = false

local conn
conn = RunService.RenderStepped:Connect(function()
    if finished then return end
    local elapsed = tick() - startTime
    local alpha = math.clamp(elapsed / LOAD_TIME, 0, 1)
    local percent = math.floor(alpha * 100 + 0.5)

    barFill.Size = UDim2.new(alpha, 0, 1, 0)
    loadSub.Text = "Loading... " .. percent .. "%"

    if alpha >= 1 then
        finished = true
        conn:Disconnect()
        -- Instant disappear (no fade, no wait)
        loadingGui:Destroy()
    end
end)

