saveIdButton.MouseButton1Click:Connect(function()
    local id = tonumber(idBox.Text)
    if not id then
        idBox.PlaceholderText = "❌ Enter an ID first!"
        idBox.Text = ""
        task.wait(1.5)
        idBox.PlaceholderText = "Enter song ID..."
        return
    end
    for _, e in ipairs(savedSongs) do
        if e.id == id then
            saveIdButton.Text = "★ Already!"
            task.wait(1.2)
            saveIdButton.Text = "★ Save"
            return
        end
    end
    table.insert(savedSongs, { id = id, name = "Song " .. id })
    saveSongsToDisk()
    refreshSavedList()
    saveIdButton.Text = "★ Saved!"
    task.wait(1.2)
    saveIdButton.Text = "★ Save"
end)

