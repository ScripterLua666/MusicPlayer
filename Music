-- ============ VOLUME ============
local currentVolume = DEFAULT_VOLUME

local function updateVolumeUI()
    volumeText.Text = math.floor(currentVolume * 100) .. "%"
    TweenService:Create(sliderFill, TweenInfo.new(0.1), {
        Size = UDim2.new(currentVolume, 0, 1, 0)
    }):Play()
    TweenService:Create(sliderKnob, TweenInfo.new(0.1), {
        Position = UDim2.new(currentVolume, 0, 0.5, 0)
    }):Play()
    if currentVolume <= 0.01 then
        sliderFill.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    elseif currentVolume < 0.3 then
        sliderFill.BackgroundColor3 = Color3.fromRGB(240, 170, 30)
    else
        sliderFill.BackgroundColor3 = Color3.fromRGB(30, 200, 90)
    end
end

local function setVolume(value)
    currentVolume = math.clamp(value, 0, 1)
    sound.Volume = currentVolume
    updateVolumeUI()
end

local sliderDragging = false

local function setVolumeFromX(mouseX)
    local relX = (mouseX - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X
    setVolume(relX)
end

sliderHit.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        setVolumeFromX(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        setVolumeFromX(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)

-- ============ PLAY / STOP ============
local function playMusic()
    if isPlaying then
        sound:Stop()
        isPlaying = false
        playButton.Text = "Play"
        playButton.BackgroundColor3 = Color3.fromRGB(30, 200, 90)
        idBox.PlaceholderText = "Enter song ID..."
        return
    end
    local id = tonumber(idBox.Text)
    if not id then
        idBox.PlaceholderText = "❌ Invalid ID!"
        idBox.Text = ""
        task.wait(1.5)
        idBox.PlaceholderText = "Enter song ID..."
        return
    end
    sound:Stop()
    sound.SoundId = "rbxassetid://" .. id
    sound:Play()
    isPlaying = true
    playButton.Text = "Stop"
    playButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    idBox.PlaceholderText = "Now playing: " .. id
end

playButton.MouseEnter:Connect(function()
    playButton.BackgroundColor3 = isPlaying and Color3.fromRGB(240, 70, 70) or Color3.fromRGB(50, 230, 110)
end)
playButton.MouseLeave:Connect(function()
    playButton.BackgroundColor3 = isPlaying and Color3.fromRGB(220, 50, 50) or Color3.fromRGB(30, 200, 90)
end)
playButton.MouseButton1Click:Connect(playMusic)

minusButton.MouseEnter:Connect(function() minusButton.BackgroundColor3 = Color3.fromRGB(55, 55, 55) end)
minusButton.MouseLeave:Connect(function() minusButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35) end)
minusButton.MouseButton1Click:Connect(function() setVolume(currentVolume - 0.1) end)

plusButton.MouseEnter:Connect(function() plusButton.BackgroundColor3 = Color3.fromRGB(55, 55, 55) end)
plusButton.MouseLeave:Connect(function() plusButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35) end)
plusButton.MouseButton1Click:Connect(function() setVolume(currentVolume + 0.1) end)

idBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then playMusic() end
end)

