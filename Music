-- ============ BALL DRAG ============
local draggingBall = false
local ballDragOffset = Vector2.new(0, 0)
local ballMoved = false
local ballPressStart = Vector2.new(0, 0)

ballButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        draggingBall = true
        ballMoved = false
        ballPressStart = Vector2.new(input.Position.X, input.Position.Y)
        ballDragOffset = Vector2.new(
            input.Position.X - ballButton.AbsolutePosition.X,
            input.Position.Y - ballButton.AbsolutePosition.Y
        )
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingBall and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local dx = math.abs(input.Position.X - ballPressStart.X)
        local dy = math.abs(input.Position.Y - ballPressStart.Y)
        if dx > 4 or dy > 4 then ballMoved = true end

        ballButton.Position = UDim2.new(
            0, input.Position.X - ballDragOffset.X,
            0, input.Position.Y - ballDragOffset.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        draggingBall = false
    end
end)

