-- // ============ VOLUME LOGIC ============
local currentVolume = DEFAULT_VOLUME

local function updateVolumeUI()
    local percent = math.floor(currentVolume * 100)
    volumeText.Text = percent .. "%"

    TweenService:Create(sliderFill, TweenInfo.new(0.1), {
        Size = UDim2.new(currentVolume, 0, 1, 0)
    }):Play()

    TweenService:Create(sliderKnob, TweenInfo.new(0.1), {
        Position = UDim2.new(currentVolume, 0, 0.5, 0)
    }):Play()

    if currentVolume <= 0.01 then
        sliderFill.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    elseif currentVolume < 0.3 then
        sliderFill.BackgroundColor3 = Color3.fromRGB(240, 170, 30)
    else
        sliderFill.BackgroundColor3 = Color3.fromRGB(30, 200, 90)
    end
end

local function setVolume(value)
    currentVolume = math.clamp(value, 0, 1)
    sound.Volume = currentVolume
    updateVolumeUI()
end

-- // ============ SLIDER DRAG ============
local sliderDragging = false

local function setVolumeFromX(mouseX)
    local relX = (mouseX - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X
    setVolume(relX)
end

sliderHit.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        setVolumeFromX(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        setVolumeFromX(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)

-- // ============ PLAY / STOP ============
local isPlaying = false

local function playMusic()
    if isPlaying then
        sound:Stop()
        isPlaying = false
        playButton.Text = "Play"
        playButton.BackgroundColor3 = Color3.fromRGB(30, 200, 90)
        idBox.PlaceholderText = "Enter song ID..."
        return
    end

    local id = tonumber(idBox.Text)
    if not id then
        idBox.PlaceholderText = "❌ Invalid ID!"
        idBox.Text = ""
        task.wait(1.5)
        idBox.PlaceholderText = "Enter song ID..."
        return
    end

    sound:Stop()
    sound.SoundId = "rbxassetid://" .. id
    sound:Play()
    isPlaying = true

    playButton.Text = "Stop"
    playButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    idBox.PlaceholderText = "Now playing: " .. id
end

-- // ============ BUTTON EVENTS ============
playButton.MouseEnter:Connect(function()
    if not isPlaying then
        playButton.BackgroundColor3 = Color3.fromRGB(50, 230, 110)
    else
        playButton.BackgroundColor3 = Color3.fromRGB(240, 70, 70)
    end
end)
playButton.MouseLeave:Connect(function()
    if not isPlaying then
        playButton.BackgroundColor3 = Color3.fromRGB(30, 200, 90)
    else
        playButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    end
end)
playButton.MouseButton1Click:Connect(playMusic)

