-- // Constants
local DEFAULT_VOLUME = 0.5
local LOAD_TIME = 7
local SAVE_FILE = "BaconHub_songs.json"

-- // ============ SAVED SONGS (PERSISTENT) ============
local savedSongs = {}

local function hasFileIO()
    return typeof(writefile) == "function"
       and typeof(readfile) == "function"
       and typeof(isfile) == "function"
end

local function loadSavedSongs()
    if not hasFileIO() then return end
    local ok, data = pcall(function()
        if isfile(SAVE_FILE) then
            return HttpService:JSONDecode(readfile(SAVE_FILE))
        end
    end)
    if ok and type(data) == "table" then
        savedSongs = data
    end
end

local function saveSongsToDisk()
    if not hasFileIO() then return end
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(savedSongs))
    end)
end

loadSavedSongs()

