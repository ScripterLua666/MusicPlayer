-- ============================================
-- // SMART PANEL POSITIONING
-- ============================================
local function positionSavedPanel()
    local cam = workspace.CurrentCamera
    local vpSize = cam.ViewportSize

    local menuX = mainFrame.AbsolutePosition.X
    local menuY = mainFrame.AbsolutePosition.Y
    local menuW = mainFrame.AbsoluteSize.X
    local panelW = savedPanel.AbsoluteSize.X
    if panelW == 0 then panelW = 340 end
    local panelH = savedPanel.AbsoluteSize.Y
    if panelH == 0 then panelH = 330 end

    local gap = 12
    local screenW = vpSize.X
    local screenH = vpSize.Y

    -- Try right side first
    local x = menuX + menuW + gap
    if x + panelW > screenW - 8 then
        -- Not enough room → put on the left
        x = menuX - panelW - gap
        if x < 8 then
            -- No room left either → clamp to the screen edge
            x = math.clamp(x, 8, screenW - panelW - 8)
        end
    end

    -- Vertical clamp
    local y = math.clamp(menuY, 8, screenH - panelH - 8)

    savedPanel.Position = UDim2.new(0, x, 0, y)
end

